# Practice 03: prototype the smallest version

Sample practice. No deadline. Each question is worth one sample point.

<question multiplechoice>
csq_name = 'concept'
csq_prompt = 'What should a first prototype do?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = 'A focused prototype can help you learn before investing in a larger build.'
csq_renderer = "radio"
csq_options = ['Answer a specific question', 'Include every feature', 'Avoid all changes']
csq_soln_mode = "index"
csq_soln = 0
</question>

<question smallbox>
csq_name = 'calculation'
csq_prompt = 'A model uses one quarter of a 20 cm length. How long is it?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = '20 × 1/4 = 5 cm.'
csq_soln = '5'
csq_size = 16
csq_prompt += ' Enter the number in cm.'
def csq_check_function(sub, sol):
    import math
    try:
        value = float(sub.strip())
        correct = math.isfinite(value) and abs(value - float(sol)) <= 0.001
    except (ValueError, TypeError, OverflowError):
        return 0, "Enter a number without units."
    return (1, '20 × 1/4 = 5 cm.') if correct else (0, "Not quite yet. Check your relationship and units, then try again.")
</question>

