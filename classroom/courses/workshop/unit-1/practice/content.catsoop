# Practice 01: ask a better question

Sample practice. No deadline. Each question is worth one sample point.

<question multiplechoice>
csq_name = 'concept'
csq_prompt = 'Which question is easiest to test?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = 'A defined comparison gives the experiment a measurable outcome.'
csq_renderer = "radio"
csq_options = ['What is the perfect object?', 'Which shape bends less under the same load?', 'Why is everything complicated?']
csq_soln_mode = "index"
csq_soln = 1
</question>

<question smallbox>
csq_name = 'calculation'
csq_prompt = 'You compare 2 designs with 3 trials each. How many trials do you run?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = '2 designs × 3 trials per design = 6 trials.'
csq_soln = '6'
csq_size = 16
csq_prompt += ' Enter the number in trials.'
def csq_check_function(sub, sol):
    import math
    try:
        value = float(sub.strip())
        correct = math.isfinite(value) and abs(value - float(sol)) <= 0.001
    except (ValueError, TypeError, OverflowError):
        return 0, "Enter a number without units."
    return (1, '2 designs × 3 trials per design = 6 trials.') if correct else (0, "Not quite yet. Check your relationship and units, then try again.")
</question>

