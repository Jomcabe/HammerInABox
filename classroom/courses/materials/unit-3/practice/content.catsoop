# Practice 03: make, test, repeat

Sample practice. No deadline. Each question is worth one sample point.

<question multiplechoice>
csq_name = 'concept'
csq_prompt = 'Which comparison is easiest to interpret?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = 'Changing one variable helps connect the observed result to that change.'
csq_renderer = "radio"
csq_options = ['Changing every condition', 'Keeping no notes', 'Changing one variable']
csq_soln_mode = "index"
csq_soln = 2
</question>

<question smallbox>
csq_name = 'calculation'
csq_prompt = 'A process takes 10 minutes per trial. How long do three trials take?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = 'Three trials × 10 minutes per trial = 30 minutes.'
csq_soln = '30'
csq_size = 16
csq_prompt += ' Enter the number in min.'
def csq_check_function(sub, sol):
    import math
    try:
        value = float(sub.strip())
        correct = math.isfinite(value) and abs(value - float(sol)) <= 0.001
    except (ValueError, TypeError, OverflowError):
        return 0, "Enter a number without units."
    return (1, 'Three trials × 10 minutes per trial = 30 minutes.') if correct else (0, "Not quite yet. Check your relationship and units, then try again.")
</question>

