# Practice 01: start with the structure

Sample practice. No deadline. Each question is worth one sample point.

<question multiplechoice>
csq_name = 'concept'
csq_prompt = 'What does a repeating unit describe?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = 'A repeating unit is a small pattern that can reconstruct a larger arrangement.'
csq_renderer = "radio"
csq_options = ['A pattern that builds the larger structure', 'The weight of the entire object', 'The color of a sample']
csq_soln_mode = "index"
csq_soln = 0
</question>

<question smallbox>
csq_name = 'calculation'
csq_prompt = 'A sample has a mass of 12 g and a volume of 4 cm³. What is its density?'
csq_npoints = 1
csq_grading_mode = "legacy"
csq_explanation = 'Density is mass divided by volume: 12 ÷ 4 = 3 g/cm³.'
csq_soln = '3'
csq_size = 16
csq_prompt += ' Enter the number in g/cm³.'
def csq_check_function(sub, sol):
    import math
    try:
        value = float(sub.strip())
        correct = math.isfinite(value) and abs(value - float(sol)) <= 0.001
    except (ValueError, TypeError, OverflowError):
        return 0, "Enter a number without units."
    return (1, 'Density is mass divided by volume: 12 ÷ 4 = 3 g/cm³.') if correct else (0, "Not quite yet. Check your relationship and units, then try again.")
</question>

